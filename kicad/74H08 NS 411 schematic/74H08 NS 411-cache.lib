EESchema-LIBRARY Version 2.3
#encoding utf-8
#
# AND
#
DEF ~AND U 0 0 N N 1 F N
F0 "U" 20 -180 60 H I C CNN
F1 "AND" 10 -100 60 H I C CNN
F2 "" 0 0 60 H I C CNN
F3 "" 0 0 60 H I C CNN
DRAW
A 100 150 90 -899 899 0 1 0 N 100 60 100 240
P 2 0 1 0 0 60 100 60 N
P 2 0 1 0 0 240 0 60 N
P 2 0 1 0 0 240 100 240 N
X A ~ -100 100 100 R 50 50 1 1 I
X B ~ -100 200 100 R 50 50 1 1 I
X ~ ~ 250 150 60 L 50 50 1 1 I
ENDDRAW
ENDDEF
#
# GNDREF
#
DEF GNDREF #PWR 0 0 Y Y 1 F P
F0 "#PWR" 0 -250 50 H I C CNN
F1 "GNDREF" 0 -150 50 H V C CNN
F2 "" 0 0 50 H V C CNN
F3 "" 0 0 50 H V C CNN
DRAW
P 2 0 1 0 -25 -75 25 -75 N
P 2 0 1 0 -5 -100 5 -100 N
P 2 0 1 0 0 -50 0 0 N
P 2 0 1 0 50 -50 -50 -50 N
X GNDREF 1 0 0 0 D 50 50 1 1 W N
ENDDRAW
ENDDEF
